{
  "name": "pluto-engine-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "docs_site"],
  "scripts": {
    "dev": "bun run --cwd apps/demo dev",
    "build:all": "bun run --if-present --filter \"@pluto-engine/vite-plugin-wgsl\" build && bun run --if-present --filter \"@pluto-engine/*\" build && bun run --if-present --filter \"pluto-engine\" build",
    "build": "bun run build:all",
    "test": "vitest run --browser.enabled=true --browser.name=chromium --browser.provider=playwright",
    "test:watch": "vitest --browser.enabled=true --browser.name=chromium --browser.provider=playwright",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@vitest/browser": "^2.0.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.40.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "version": "1.0.7"
}
