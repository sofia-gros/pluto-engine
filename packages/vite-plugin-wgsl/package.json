{
  "name": "@pluto-engine/vite-plugin-wgsl",
  "version": "1.0.9",
  "description": "Vite plugin to load WGSL files and optionally transpile to GLSL",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {},
  "devDependencies": {
    "vite": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "vite": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0"
  }
}
