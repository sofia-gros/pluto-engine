{
  "name": "@pluto-engine/core",
  "version": "1.0.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@pluto-engine/renderer": "workspace:*"
  }
}
